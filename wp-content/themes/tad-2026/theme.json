{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": false,
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "fg",
          "name": "Text",
          "color": "var(--fg)"
        },
        {
          "slug": "fg-2",
          "name": "Text (soft)",
          "color": "var(--fg-2)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--muted)"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "var(--accent)"
        },
        {
          "slug": "brand-sun",
          "name": "Brand sun",
          "color": "var(--brand-sun)"
        },
        {
          "slug": "brand-flare",
          "name": "Brand flare",
          "color": "var(--brand-flare)"
        },
        {
          "slug": "brand-violet",
          "name": "Brand violet",
          "color": "var(--brand-violet)"
        }
      ]
    },
    "custom": {
      "layout": {
        "content": "72rem",
        "narrow": "48rem"
      }
    },
    "layout": {
      "contentSize": "72rem",
      "wideSize": "88rem"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "none",
          "name": "None",
          "size": "0px"
        },
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "1rem"
        },
        {
          "slug": "md",
          "name": "MD",
          "size": "1.5rem"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "2.5rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "4rem"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "padding": true,
      "margin": true
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "display",
          "name": "Recursive (display)",
          "fontFamily": "Recursive, Inter, ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "1rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.25rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.75rem"
        },
        {
          "slug": "x-large",
          "name": "XL",
          "size": "2.5rem"
        }
      ],
      "lineHeight": false
    }
  },
  "styles": {
    "color": {
      "background": "transparent",
      "text": "var(--fg)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.52"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--accent)"
        }
      }
    }
  }
}
